# Variables de entorno requeridas. Copiar a `.env` (local) y cargarlas en
# Vercel → Project Settings → Environment Variables (Production + Preview).
# NUNCA commitear el `.env` real con valores.

# --- Supabase (obligatorias) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth propia de la API / extensión (obligatoria) ---
# Cadena larga y aleatoria. Sin esto, la autenticación por token de la
# extensión queda deshabilitada (fail-closed).
JWT_SECRET=

# --- Zoom (opcional: agendar reuniones desde Revisiones) ---
# Server-to-Server OAuth. Si faltan, /api/zoom/meeting responde error;
# el resto de la app funciona.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# --- IA (opcional: "Diagnóstico IA" en Ruta Crítica técnica) ---
GROQ_API_KEY=
