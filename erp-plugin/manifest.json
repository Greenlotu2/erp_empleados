{
  "manifest_version": 3,
  "name": "ERP - Panel del Empleado",
  "version": "1.0",
  "description": "Extensión para gestión de tareas, temporizador de servicio y notificaciones de reuniones",
  "permissions": [
    "sidePanel",
    "storage",
    "windows"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*.supabase.co/*"
  ],
  "action": {
    "default_title": "Abrir Panel de Empleado"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}