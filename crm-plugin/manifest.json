{
  "manifest_version": 3,
  "name": "CRM - Panel del Trabajador",
  "version": "1.0",
  "description": "Plugin para control de disponibilidad y reporte de actividades de empleados.",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://localhost:3000/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}